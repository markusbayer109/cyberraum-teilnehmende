# Standardroute: LiteLLM der TU Darmstadt.
LLM_PROVIDER=litellm
LITELLM_BASE_URL=https://llm-service.ai.tu-darmstadt.de/v1
LITELLM_API_KEY=hier-teambezogenen-key-eintragen

# Standardmodell, bei Bedarf ohne Codeänderung überschreibbar.
LITELLM_MODEL=GLM-5.2-AWQ-INT4

# Plan 2 bei einem Ausfall des TU-Dienstes. Erst dann LLM_PROVIDER=openrouter
# setzen und die beiden folgenden Werte befüllen.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Eigene, isolierte Juice-Shop-Instanz des Teams.
TARGET_BASE_URL=http://127.0.0.1:3000
